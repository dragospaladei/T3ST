Cell[BoxData[{
 RowBox[{
  RowBox[{"ratio", "=", 
   RowBox[{"ArrayReshape", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Phi]", ",", "\[Nu]", ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[ScriptCapitalD]full", "[", 
             RowBox[{"\[Phi]", ",", "\[Nu]"}], "]"}], "-", 
            RowBox[{"\[ScriptCapitalD]turb", "[", "\[Phi]", "]"}], "-", 
            RowBox[{"\[ScriptCapitalD]coll", "[", "\[Nu]", "]"}]}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"Sqrt", "[", 
              RowBox[{
               RowBox[{"\[ScriptCapitalD]turb", "[", "\[Phi]", "]"}], 
               RowBox[{"\[ScriptCapitalD]coll", "[", "\[Nu]", "]"}]}], "]"}], 
             "2"], "+", "0.00"}], ")"}]}]}], "}"}], ",", 
