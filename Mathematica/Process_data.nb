        RowBox[{
        "a0", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}]}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{
        "a0", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], ",", 
       RowBox[{"a0", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}],
       "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"torusSurface", "=", 
