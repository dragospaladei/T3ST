 RowBox[{
  RowBox[{"full", "=", 
   RowBox[{"ArrayReshape", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Phi]", ",", "\[Nu]", ",", 
