Cell[BoxData[
 RowBox[{"Monitor", "[", 
  RowBox[{
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"Simulation", "=", "1"}], ",", 
     RowBox[{"Simulation", "\[LessEqual]", "17"}], ",", 
     RowBox[{"Simulation", "++"}], ",", 
     RowBox[{
      RowBox[{"folder", "=", 
       RowBox[{
        RowBox[{"StringDrop", "[", 
         RowBox[{
          RowBox[{"NotebookDirectory", "[", "]"}], ",", 
          RowBox[{"-", "12"}]}], "]"}], "<>", "\"\<data/Sim_\>\""}]}], ";", 
      "\n", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"Simulation", "<", "10"}], ",", 
        RowBox[{
         RowBox[{"folder", "=", 
          RowBox[{"folder", "<>", "\"\<0\>\"", "<>", 
           RowBox[{"ToString", "[", "Simulation", "]"}], 
           "<>", "\"\</\>\""}]}], ";"}], ",", 
        RowBox[{
         RowBox[{"folder", "=", 
          RowBox[{"folder", "<>", 
           RowBox[{"ToString", "[", "Simulation", "]"}], 
           "<>", "\"\</\>\""}]}], ";"}]}], "]"}], ";", 
      RowBox[{
       SubscriptBox["fig", 
        RowBox[{"Simulation", ",", "1"}]], "=", 
       RowBox[{"Import", "[", 
        RowBox[{"folder", "<>", "\"\</fig_1_a.png\>\""}], "]"}]}], ";", 
      RowBox[{
       SubscriptBox["fig", 
        RowBox[{"Simulation", ",", "2"}]], "=", 
       RowBox[{"Import", "[", 
        RowBox[{"folder", "<>", "\"\</fig_1_b.png\>\""}], "]"}]}], ";", 
      RowBox[{
       SubscriptBox["fig", 
        RowBox[{"Simulation", ",", "3"}]], "=", 
       RowBox[{"Import", "[", 
        RowBox[{"folder", "<>", "\"\</fig_2_a.png\>\""}], "]"}]}], ";", 
      RowBox[{
       SubscriptBox["fig", 
        RowBox[{"Simulation", ",", "4"}]], "=", 
       RowBox[{"Import", "[", 
        RowBox[{"folder", "<>", "\"\</fig_2_b.png\>\""}], "]"}]}], ";", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"as", "=", "1"}], ",", 
        RowBox[{"as", "\[LessEqual]", "nsim2"}], ",", 
        RowBox[{"as", "++"}], ",", 
        RowBox[{
         SubscriptBox["fig", 
          RowBox[{"Simulation", ",", 
           RowBox[{"4", "+", "as"}]}]], "=", 
         RowBox[{"Import", "[", 
          RowBox[{"folder", "<>", "\"\</fig_3_\>\"", "<>", 
           RowBox[{"ToString", "[", "as", "]"}], "<>", "\"\<.png\>\""}], 
          "]"}]}]}], "]"}], ";"}]}], "]"}], ",", "Simulation"}], 
  "]"}]], "Input",
