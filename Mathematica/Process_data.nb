Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"torus", "[", 
    RowBox[{"u_", ",", "v_", ",", 
     RowBox[{"R_", ":", "1"}], ",", 
     RowBox[{"r_", ":", 
      RowBox[{
      "a0", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}]}], "]"}],
    ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"R", "+", 
        RowBox[{"r", " ", 
         RowBox[{"Cos", "[", "v", "]"}]}]}], ")"}], " ", 
      RowBox[{"Cos", "[", "u", "]"}]}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"R", "+", 
        RowBox[{"r", " ", 
         RowBox[{"Cos", "[", "v", "]"}]}]}], ")"}], " ", 
      RowBox[{"Sin", "[", "u", "]"}]}], ",", 
     RowBox[{"r", " ", 
      RowBox[{"Sin", "[", "v", "]"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"limits", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{
          "a0", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
         ")"}]}], ",", 
       RowBox[{"1", "+", 
        RowBox[{
        "a0", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}]}], 
      "}"}], ",", 
     RowBox[{"{", 
