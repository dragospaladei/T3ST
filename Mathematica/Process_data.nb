 RowBox[{
  RowBox[{"as", "=", "1"}], ";", 
  RowBox[{"\[Theta]", "=", 
   RowBox[{"ArcTan", "[", 
    RowBox[{
     RowBox[{"Xallin", "-", "1"}], ",", "Yallin"}], "]"}]}], ";", 
  RowBox[{"guess", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        SuperscriptBox[
         RowBox[{"Cos", "[", "\[Theta]2", "]"}], "3"], 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"\[Epsilon]", " ", 
           RowBox[{"Cos", "[", "\[Theta]2", "]"}]}]}], ")"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Theta]2", ",", "0", ",", 
         RowBox[{"2", "\[Pi]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Xi]2", ",", "0", ",", 
         RowBox[{"2", "\[Pi]"}]}], "}"}]}], "]"}], "/", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"\[Epsilon]", " ", 
          RowBox[{"Cos", "[", "\[Theta]2", "]"}]}]}], ")"}], ",", 
