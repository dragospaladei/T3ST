Cell[BoxData[{
 RowBox[{
  RowBox[{"\[ScriptCapitalD]full", "=", 
   RowBox[{"Interpolation", "[", 
    RowBox[{"Transpose", "[", 
     RowBox[{"{", 
      RowBox[{"Phi", ",", "nub", ",", "DQas"}], "}"}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"\[ScriptCapitalD]turb", "=", 
   RowBox[{"Interpolation", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Phi", "\[LeftDoubleBracket]", 
         RowBox[{
          RowBox[{"20", "i"}], "+", "1"}], "\[RightDoubleBracket]"}], ",", 
        RowBox[{"DQas", "\[LeftDoubleBracket]", 
         RowBox[{
          RowBox[{"20", " ", "i"}], "+", "1"}], "\[RightDoubleBracket]"}]}], 
       "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "0", ",", "9"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[ScriptCapitalD]coll", "=", 
