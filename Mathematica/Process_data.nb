Cell[BoxData[
 RowBox[{"Monitor", "[", 
  RowBox[{
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"i", "=", "1"}], ",", 
     RowBox[{"i", "\[LessEqual]", "nsim2"}], ",", 
     RowBox[{"i", "++"}], ",", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"j", "=", "1"}], ",", 
       RowBox[{"j", "\[LessEqual]", 
        RowBox[{
        "Nloop", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], ",", 
       RowBox[{"j", "++"}], ",", 
       RowBox[{
        RowBox[{
         SubscriptBox["trajx", 
          RowBox[{"i", ",", "j"}]], "=", 
         RowBox[{"Interpolation", "[", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
             "t", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", 
             RowBox[{"X", "\[LeftDoubleBracket]", 
              RowBox[{"i", ",", "1", ",", "j", ",", "2"}], 
              "\[RightDoubleBracket]"}]}], "}"}], "]"}], "]"}]}], ";", 
        RowBox[{
         SubscriptBox["trajy", 
          RowBox[{"i", ",", "j"}]], "=", 
