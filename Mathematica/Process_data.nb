Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"graftime", "[", 
    RowBox[{"content_", ",", "name_"}], "]"}], ":=", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{"content", ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"PlotTheme", "->", "\"\<Scientific\>\""}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<t\>\"", ",", "name"}], "}"}]}], ",", 
     RowBox[{"LabelStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Black", ",", "Bold", ",", "15", ",", 
        RowBox[{"FontFamily", "->", "\"\<Times\>\""}]}], "}"}]}], ",", 
     RowBox[{"ImageSize", "->", "Medium"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{
       "Red", ",", "Blue", ",", "Green", ",", "Brown", ",", " ", "Orange", ",",
         "Cyan"}], "}"}]}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"Placed", "[", 
       RowBox[{"Automatic", ",", 
        RowBox[{"{", 
         RowBox[{"0.9", ",", "0.5"}], "}"}]}], "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"histo", "[", 
    RowBox[{"content_", ",", "name_"}], "]"}], ":=", 
   RowBox[{"Histogram", "[", 
    RowBox[{"content", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Max", "[", 
        RowBox[{"content", "//", "Flatten"}], "]"}], "/", "20"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"PlotTheme", "->", "\"\<Scientific\>\""}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"name", ",", 
        RowBox[{"\"\<P[\>\"", "<>", "name", "<>", "\"\<]\>\""}]}], "}"}]}], ",", 
     RowBox[{"LabelStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Black", ",", "Bold", ",", "15", ",", 
        RowBox[{"FontFamily", "->", "\"\<Times\>\""}]}], "}"}]}], ",", 
     RowBox[{"ImageSize", "->", "Medium"}], ",", 
     RowBox[{"ChartStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Red", ",", "Blue", ",", "Green"}], "}"}]}], ",", 
     RowBox[{"ChartLegends", "->", 
      RowBox[{"Placed", "[", 
       RowBox[{"Automatic", ",", 
        RowBox[{"{", 
         RowBox[{"0.9", ",", "0.5"}], "}"}]}], "]"}]}]}], "]"}]}], 
  ";"}]}], "Input",
