     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"nub", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}],
         ",", 
        RowBox[{
        "DQas", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
       "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "20"}], "}"}]}], "]"}], "]"}]}], 
