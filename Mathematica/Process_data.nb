Cell[BoxData[{
 RowBox[{
  RowBox[{"frac", "=", "0.6"}], ";", 
  RowBox[{"difD", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Mean", "[", 
      RowBox[{
       FractionBox[
        RowBox[{
         SuperscriptBox[
          RowBox[{
          "rhoi", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
          "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"RotateLeft", "[", 
