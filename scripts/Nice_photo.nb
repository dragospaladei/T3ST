Notebook[{
Cell[BoxData[
 RowBox[{"Monitor", "[", 
  RowBox[{
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"Simulation", "=", "1"}], ",", 
     RowBox[{"Simulation", "\[LessEqual]", "7"}], ",", 
     RowBox[{"Simulation", "++"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"simi", ",", "nsim"}], "}"}], "=", 
       RowBox[{"{", 
        RowBox[{"1", ",", "20"}], "}"}]}], ";", 
      RowBox[{"folder", "=", 
       RowBox[{
        RowBox[{"StringDrop", "[", 
         RowBox[{
          RowBox[{"NotebookDirectory", "[", "]"}], ",", 
          RowBox[{"-", "12"}]}], "]"}], "<>", "\"\<data/Sim_\>\""}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"Simulation", "<", "10"}], ",", 
        RowBox[{
         RowBox[{"folder", "=", 
          RowBox[{"folder", "<>", "\"\<0\>\"", "<>", 
           RowBox[{"ToString", "[", "Simulation", "]"}], 
           "<>", "\"\</\>\""}]}], ";"}], ",", 
        RowBox[{
         RowBox[{"folder", "=", 
          RowBox[{"folder", "<>", 
           RowBox[{"ToString", "[", "Simulation", "]"}], 
           "<>", "\"\</\>\""}]}], ";"}]}], "]"}], " ", ";", 
      RowBox[{"nsim2", "=", 
       RowBox[{"nsim", "-", "simi", "+", "1"}]}], ";", 
      RowBox[{"pars", "=", 
       RowBox[{"0", " ", 
        RowBox[{"Range", "[", "nsim2", "]"}]}]}], ";", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "simi"}], ",", 
        RowBox[{"i", "\[LessEqual]", "nsim"}], ",", 
        RowBox[{"i", "++"}], ",", 
        RowBox[{
         RowBox[{"run", "=", 
          RowBox[{"\"\<Run_\>\"", "<>", 
           RowBox[{"StringJoin", "[", 
            RowBox[{"Table", "[", 
             RowBox[{"\"\<0\>\"", ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", 
                RowBox[{"4", "-", 
                 RowBox[{"IntegerPart", "[", 
                  RowBox[{"Log", "[", 
                   RowBox[{"10.", ",", "i"}], "]"}], "]"}]}]}], "}"}]}], 
             "]"}], "]"}]}]}], ";", 
         RowBox[{"igood", "=", 
          RowBox[{"i", "-", "simi", "+", "1"}]}], ";", 
         RowBox[{
          RowBox[{
          "pars", "\[LeftDoubleBracket]", "igood", "\[RightDoubleBracket]"}], 
          "=", 
          RowBox[{"Flatten", "[", 
           RowBox[{"Import", "[", 
            RowBox[{
             RowBox[{"folder", "<>", "run", "<>", 
              RowBox[{"ToString", "[", "i", "]"}], 
              "<>", "\"\</file_01.dat\>\""}], ",", "\"\<Table\>\""}], "]"}], 
           "]"}]}], ";", 
         RowBox[{"len", "=", 
          RowBox[{"IntegerPart", "[", 
           RowBox[{
            FractionBox["1", "2"], " ", 
            RowBox[{"Length", "[", 
             RowBox[{
             "pars", "\[LeftDoubleBracket]", "igood", 
              "\[RightDoubleBracket]"}], "]"}]}], "]"}]}], ";", 
         RowBox[{
          SubscriptBox["keep", 
           RowBox[{"Simulation", ",", "i"}]], "=", 
          RowBox[{"pars", "[", 
           RowBox[{"[", "igood", "]"}], "]"}]}]}]}], "]"}]}]}], "]"}], ",", 
   RowBox[{"Row", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ProgressIndicator", "[", 
       RowBox[{"i", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "nsim2"}], "}"}]}], "]"}], ",", 
      RowBox[{
       RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\</\>\"", "<>", 
       RowBox[{"ToString", "[", "nsim2", "]"}]}]}], "}"}], "]"}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.97054578922307*^9, 3.9705458660943737`*^9}, {
  3.9705459532484074`*^9, 3.970546023163787*^9}, {3.9707326855455933`*^9, 
