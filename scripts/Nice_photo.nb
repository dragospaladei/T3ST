Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"pairs", "=", 
    RowBox[{"Transpose", "@", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Subscript", "[", 
         RowBox[{"keep", ",", "1", ",", "1"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", "len"}], "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{"Subscript", "[", 
         RowBox[{"keep", ",", "1", ",", "1"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"len", "+", "1"}], ";;", 
          RowBox[{"2", " ", "len"}]}], "]"}], "]"}]}], "}"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"cols", "=", "7"}], ";", 
   RowBox[{"(*", 
    RowBox[{"number", " ", "of", " ", "pairs", " ", "per", " ", "row"}], 
    "*)"}], 
   RowBox[{"reshapedPairs", "=", 
    RowBox[{"Partition", "[", 
     RowBox[{"pairs", ",", "cols", ",", "cols", ",", "1", ",", 
      RowBox[{"{", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{"grr", "=", 
  RowBox[{"Grid", "[", 
   RowBox[{
    RowBox[{"Map", "[", 
     RowBox[{"Column", ",", "reshapedPairs", ",", 
      RowBox[{"{", "2", "}"}]}], "]"}], ",", 
    RowBox[{"(*", 
     RowBox[{"makes", " ", "each", " ", "pair", " ", 
      RowBox[{"vertical", ":", 
       RowBox[{"{", 
        RowBox[{"a_i", ",", "b_i"}], "}"}]}]}], "*)"}], 
    RowBox[{"Frame", "\[Rule]", "All"}], ",", 
    RowBox[{"Spacings", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"2", ",", "1"}], "}"}]}], ",", 
    RowBox[{"Alignment", "\[Rule]", "Center"}], ",", 
    RowBox[{"Background", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"None", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Lighter", "[", 
          RowBox[{"Gray", ",", "0.9"}], "]"}], ",", "White"}], "}"}]}], 
      "}"}]}], ",", 
    RowBox[{"ItemStyle", "\[Rule]", 
     RowBox[{"Directive", "[", 
      RowBox[{
       RowBox[{"FontSize", "\[Rule]", "16"}], ",", 
       RowBox[{"FontFamily", "\[Rule]", "\"\<Helvetica\>\""}]}], "]"}]}]}], 
   "]"}]}]}], "Input",
