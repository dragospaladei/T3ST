#!/bin/bash

compile_main() (
    set -o pipefail

    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

    make -C "$PROJECT_ROOT/src/fortran"
)

compile_main "$@"
status=$?
unset -f compile_main
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
    return "$status"
else
    exit "$status"
fi
