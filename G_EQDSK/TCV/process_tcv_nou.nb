Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"as", "=", "1"}], ";", 
  RowBox[{"boundary", "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
      "rbound", "\[LeftDoubleBracket]", "as", "\[RightDoubleBracket]"}], ",", 
      RowBox[{
      "zbound", "\[LeftDoubleBracket]", "as", "\[RightDoubleBracket]"}]}], 
     "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"boundaryPolygon", "=", 
   RowBox[{"Polygon", "[", "boundary", "]"}]}], ";", 
  RowBox[{"insideQ", "=", 
   RowBox[{"RegionMember", "[", "boundaryPolygon", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"points", "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"R", "\[LeftDoubleBracket]", "as", "\[RightDoubleBracket]"}], 
       "]"}], ",", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Z", "\[LeftDoubleBracket]", "as", "\[RightDoubleBracket]"}], 
       "]"}], ",", 
      RowBox[{"Flatten", "[", 
       RowBox[{
       "\[Rho]", "\[LeftDoubleBracket]", "as", "\[RightDoubleBracket]"}], 
       "]"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"filteredPoints", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"points", ",", 
     RowBox[{
      RowBox[{"insideQ", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
          ",", 
         RowBox[{
         "#1", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
        "}"}], "]"}], "&"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"points", "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"R", "\[LeftDoubleBracket]", "as", "\[RightDoubleBracket]"}], 
       "]"}], ",", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Z", "\[LeftDoubleBracket]", "as", "\[RightDoubleBracket]"}], 
       "]"}], ",", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{
        "raza", "\[LeftDoubleBracket]", "as", "\[RightDoubleBracket]"}], "/", 
        RowBox[{"a", "[", 
         RowBox[{"[", "as", "]"}], "]"}]}], "]"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"filteredPoints2", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"points", ",", 
     RowBox[{
      RowBox[{"insideQ", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
          ",", 
         RowBox[{
         "#1", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
        "}"}], "]"}], "&"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot3D", "[", 
