Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Proof", " ", "that", " ", "SIMAG", " ", "is", " ", "the", " ", "poloidal",
     " ", "flux", " ", "at", " ", "the", " ", "magnetic", " ", "axis"}], 
   "*)"}], 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"ListLinePlot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"R", "\[LeftDoubleBracket]", 
            RowBox[{"as", ",", "All", ",", "fas"}], "\[RightDoubleBracket]"}],
            ",", 
           RowBox[{"PSI", "\[LeftDoubleBracket]", 
            RowBox[{"as", ",", "All", ",", "fas"}], 
            "\[RightDoubleBracket]"}]}], "}"}], "]"}], ",", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"R", "\[LeftDoubleBracket]", 
            RowBox[{"as", ",", "All", ",", "fas"}], "\[RightDoubleBracket]"}],
            ",", 
           RowBox[{
