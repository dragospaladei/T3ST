Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Plasma", " ", "Boundary"}], ",", " ", 
    RowBox[{"tokamak", " ", "volume"}], ",", " ", 
    RowBox[{
    "poloidal", " ", "flux", " ", "and", " ", "F", " ", "in", " ", 
     "contourplots"}]}], "*)"}], 
  RowBox[{
   RowBox[{"as", "=", "1"}], ";", 
   RowBox[{"grafs", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ListContourPlot", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Flatten", "[", 
            RowBox[{
            "R", "\[LeftDoubleBracket]", "as", "\[RightDoubleBracket]"}], 
            "]"}], ",", 
           RowBox[{"Flatten", "[", 
            RowBox[{
            "Z", "\[LeftDoubleBracket]", "as", "\[RightDoubleBracket]"}], 
            "]"}], ",", 
           RowBox[{"Flatten", "[", 
            RowBox[{
            "PSI", "\[LeftDoubleBracket]", "as", "\[RightDoubleBracket]"}], 
            "]"}]}], "}"}], "]"}], ",", 
        RowBox[{"Contours", "\[Rule]", "30"}], ",", 
        RowBox[{"AspectRatio", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{
            "R", "\[LeftDoubleBracket]", "as", "\[RightDoubleBracket]"}], 
            "]"}], ",", 
           RowBox[{"2", " ", 
            RowBox[{"Max", "[", 
             RowBox[{
             "Z", "\[LeftDoubleBracket]", "as", "\[RightDoubleBracket]"}], 
             "]"}]}]}], "}"}]}], ",", 
        RowBox[{"PlotTheme", "\[Rule]", "\"\<Scientific\>\""}], ",", 
        RowBox[{"FrameLabel", "\[Rule]", 
         RowBox[{"{", 
          
          RowBox[{"\"\<R [m]\>\"", ",", "\"\<Z [m]\>\"", 
           ",", "\"\<\[Psi]\>\""}], "}"}]}], ",", 
        RowBox[{"LabelStyle", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"Black", ",", "Bold", ",", "15"}], "}"}]}], ",", 
        RowBox[{"ImageSize", "\[Rule]", "300"}]}], "]"}], ",", 
      RowBox[{"ListContourPlot", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Flatten", "[", 
