Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"as", "=", "1"}], ";", 
  RowBox[{"npp", "=", "np"}], ";", 
  RowBox[{"\[CapitalDelta]", "=", 
   FractionBox[
    RowBox[{
     RowBox[{"SIBRY", "\[LeftDoubleBracket]", "as", "\[RightDoubleBracket]"}],
      "-", 
     RowBox[{
     "SIMAG", "\[LeftDoubleBracket]", "as", "\[RightDoubleBracket]"}]}], 
    RowBox[{"npp", "-", "1"}]]}], ";", 
  RowBox[{"\[Psi]", "=", 
   RowBox[{
    RowBox[{"SIMAG", "\[LeftDoubleBracket]", "as", "\[RightDoubleBracket]"}], 
    "+", 
    RowBox[{"\[CapitalDelta]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Range", "[", "npp", "]"}], "-", "1"}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"q", ",", "P", ",", "F", ",", "pp", ",", "ffp"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Interpolation", "[", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"\[Psi]", ",", 
         RowBox[{
         "Q", "\[LeftDoubleBracket]", "as", "\[RightDoubleBracket]"}]}], 
        "}"}], "]"}], "]"}], ",", 
     RowBox[{"Interpolation", "[", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"\[Psi]", ",", 
